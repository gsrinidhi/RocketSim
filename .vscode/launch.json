{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run program",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/main",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build",
            "MIMode": "gdb"
        },
        {
            "name": "Run guidProgram",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/guidProgram",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build",
            "MIMode": "gdb"
        }
    ],
    "compounds": [
        {
        "name": "Debug Both C++ Programs",
        "configurations": ["Run program", "Run guidProgram"],
        "stopAll": true
        }
    ],
    "environment": [
    {
        "name": "ASAN_OPTIONS",
        "value": "detect_leaks=0"
    }
]
}